{
"openapi": "3.0.0",
"info": {
    "title": "Cherry K-Beauty API",
    "description": "API REST para el ecommerce Cherry, una tienda de productos K-beauty. Permite gestionar usuarios, productos, carrito de compras, órdenes y pagos con Stripe. Desarrollada por Ana Fontana.",
    "version": "1.0.0",
    "contact": {
    "name": "Ana Fontana.",
    "email": "anafontana822@hotmail.com"
    }
},
"servers": [
    {
    "url": "http://localhost:3000/api",
    "description": "Development server"
    }
],
"components": {
    "securitySchemes": {
    "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "access_token"
    }
    },
    "schemas": {
    "User": {
        "type": "object",
        "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "telephone": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin", "moderator"] }
        }
    },
    "Product": {
        "type": "object",
        "properties": {
        "_id": { "type": "string" },
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "image": { "type": "string" },
        "categories": { "type": "string" },
        "subcategory": { "type": "string" },
        "description": { "type": "string" }
        }
    },
    "Cart": {
        "type": "object",
        "properties": {
        "_id": { "type": "string" },
        "userId": { "type": "string" },
        "items": {
            "type": "array",
            "items": {
            "type": "object",
            "properties": {
                "productId": { "type": "string" },
                "quantity": { "type": "integer" },
                "price": { "type": "number" }
            }
            }
        },
        "subtotal": { "type": "number" },
        "shippingCost": { "type": "number" },
        "total": { "type": "number" }
        }
    },
    "Order": {
        "type": "object",
        "properties": {
        "_id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "userId": { "type": "string" },
        "items": {
            "type": "array",
            "items": {
            "type": "object",
            "properties": {
                "productId": { "type": "string" },
                "name": { "type": "string" },
                "brand": { "type": "string" },
                "quantity": { "type": "integer" },
                "price": { "type": "number" },
                "subtotal": { "type": "number" }
            }
            }
        },
        "shippingAddress": {
            "type": "object",
            "properties": {
            "fullName": { "type": "string" },
            "address": { "type": "string" },
            "city": { "type": "string" },
            "state": { "type": "string" },
            "zipCode": { "type": "string" },
            "country": { "type": "string" },
            "phone": { "type": "string" },
            "notes": { "type": "string" }
            }
        },
        "subtotal": { "type": "number" },
        "shippingCost": { "type": "number" },
        "total": { "type": "number" },
        "status": {
            "type": "string",
            "enum": ["pending", "paid", "shipped", "delivered", "cancelled"]
        },
        "paymentStatus": {
            "type": "string",
            "enum": ["pending", "paid", "failed"]
        },
        "paymentIntentId": { "type": "string" }
        }
    }
    }
},
"paths": {
    "/auth/signup": {
    "post": {
        "tags": ["Auth"],
        "summary": "Register a new user",
        "description": "Creates a new user account and returns an access token via cookie.",
        "requestBody": {
        "required": true,
        "content": {
            "application/json": {
            "schema": {
                "type": "object",
                "required": ["fullName", "email", "password"],
                "properties": {
                "fullName": { "type": "string", "example": "Ana Fontana" },
                "email": { "type": "string", "example": "ana@test.com" },
                "telephone": { "type": "string", "example": "1122334455" },
                "password": { "type": "string", "example": "123456" }
                }
            }
            }
        }
        },
        "responses": {
        "200": { "description": "User registered successfully" },
        "400": { "description": "Validation error" },
        "409": { "description": "Email already in use" }
        }
    }
    },
    "/auth/signin": {
    "post": {
        "tags": ["Auth"],
        "summary": "Login user",
        "description": "Authenticates the user and sets an access token cookie.",
        "requestBody": {
        "required": true,
        "content": {
            "application/json": {
            "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                "email": { "type": "string", "example": "ana@test.com" },
                "password": { "type": "string", "example": "123456" }
                }
            }
            }
        }
        },
        "responses": {
        "200": { "description": "Login successful" },
        "400": { "description": "Validation error" },
        "401": { "description": "Invalid password" },
        "404": { "description": "User not found" }
        }
    }
    },
    "/auth/logout": {
    "post": {
        "tags": ["Auth"],
        "summary": "Logout user",
        "description": "Clears the access token and refresh token cookies.",
        "security": [{ "cookieAuth": [] }],
        "responses": {
        "200": { "description": "Logged out successfully" }
        }
    }
    },
    "/auth/refresh": {
    "post": {
        "tags": ["Auth"],
        "summary": "Refresh access token",
        "description": "Generates a new access token using the refresh token cookie.",
        "responses": {
        "200": { "description": "Token refreshed" },
        "401": { "description": "No refresh token" },
        "403": { "description": "Invalid or expired refresh token" }
        }
    }
    },
    "/auth/me": {
    "get": {
        "tags": ["Auth"],
        "summary": "Get current user session",
        "description": "Returns the current authenticated user's id, email and role from the token.",
        "security": [{ "cookieAuth": [] }],
        "responses": {
        "200": { "description": "User session data" },
        "401": { "description": "Unauthorized" }
        }
    }
    },
    "/users/profile": {
    "get": {
        "tags": ["Users"],
        "summary": "Get user profile",
        "description": "Returns the full profile of the authenticated user including name, email, address and telephone.",
        "security": [{ "cookieAuth": [] }],
        "responses": {
        "200": { "description": "User profile data" },
        "401": { "description": "Unauthorized" }
        }
    }
    },
    "/products": {
    "get": {
        "tags": ["Products"],
        "summary": "Get all products",
        "description": "Returns a list of all active products. Can be filtered by category, brand, subcategory or search term.",
        "parameters": [
        {
            "name": "category",
            "in": "query",
            "description": "Filter by category (e.g. skincare, makeup)",
            "schema": { "type": "string" }
        },
        {
            "name": "brand",
            "in": "query",
            "description": "Filter by brand name",
            "schema": { "type": "string" }
        },
        {
            "name": "subcategory",
            "in": "query",
            "description": "Filter by subcategory (e.g. lipstick, blush)",
            "schema": { "type": "string" }
        },
        {
            "name": "search",
            "in": "query",
            "description": "Search by name, brand or description",
            "schema": { "type": "string" }
        }
        ],
        "responses": {
        "200": { "description": "List of products" },
        "404": { "description": "No products found" }
        }
    },
    "post": {
        "tags": ["Products"],
        "summary": "Create a product",
        "description": "Creates a new product with image upload to Cloudinary. Requires admin authentication.",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
        "required": true,
        "content": {
            "multipart/form-data": {
            "schema": {
                "type": "object",
                "properties": {
                "image": { "type": "string", "format": "binary" },
                "name": { "type": "string" },
                "description": { "type": "string" },
                "price": { "type": "number" },
                "brand": { "type": "string" },
                "stock": { "type": "integer" },
                "categories": { "type": "string" },
                "subcategory": { "type": "string" }
                }
            }
            }
        }
        },
        "responses": {
        "201": { "description": "Product created successfully" },
        "401": { "description": "Unauthorized" }
        }
    }
    },
    "/products/{id}": {
    "get": {
        "tags": ["Products"],
        "summary": "Get product by ID",
        "description": "Returns a single product by its MongoDB ID.",
        "parameters": [
        {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "MongoDB product ID",
            "schema": { "type": "string" }
        }
        ],
        "responses": {
        "200": { "description": "Product data" },
        "404": { "description": "Product not found" }
        }
      },
      "patch": {
        "tags": ["Products"],
        "summary": "Update a product",
        "description": "Updates product data. If a new image is provided, the old one is deleted from Cloudinary.",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
        {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "MongoDB product ID",
            "schema": { "type": "string" }
        }
        ],
        "requestBody": {
        "content": {
            "multipart/form-data": {
            "schema": {
                "type": "object",
                "properties": {
                "image": { "type": "string", "format": "binary" },
                "name": { "type": "string" },
                "description": { "type": "string" },
                "price": { "type": "number" },
                "brand": { "type": "string" },
                "stock": { "type": "integer" },
                "categories": { "type": "string" },
                "subcategory": { "type": "string" }
                }
            }
            }
        }
        },
        "responses": {
        "200": { "description": "Product updated successfully" },
        "401": { "description": "Unauthorized" },
        "404": { "description": "Product not found" }
        }
    },
    "delete": {
        "tags": ["Products"],
        "summary": "Delete a product",
        "description": "Deletes a product and its image from Cloudinary.",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
        {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "MongoDB product ID",
            "schema": { "type": "string" }
        }
        ],
        "responses": {
        "200": { "description": "Product deleted successfully" },
        "401": { "description": "Unauthorized" },
        "404": { "description": "Product not found" }
        }
    }
    },
    "/carts": {
    "get": {
        "tags": ["Cart"],
        "summary": "Get user cart",
        "description": "Returns the cart of the authenticated user with populated product details.",
        "security": [{ "cookieAuth": [] }],
        "responses": {
        "200": { "description": "Cart data" },
        "401": { "description": "Unauthorized" }
        }
    }
    },
    "/carts/add": {
    "post": {
        "tags": ["Cart"],
        "summary": "Add product to cart",
        "description": "Adds a product to the authenticated user's cart. If the product already exists, increases the quantity.",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
        "required": true,
        "content": {
            "application/json": {
            "schema": {
                "type": "object",
                "required": ["productId", "quantity", "price"],
                "properties": {
                "productId": {
                    "type": "string",
                    "example": "67fc1f0afd41c314c3dde5f1"
                },
                "quantity": { "type": "integer", "example": 1 },
                "price": { "type": "number", "example": 7.99 }
                }
            }
            }
        }
        },
        "responses": {
        "200": { "description": "Product added to cart" },
        "400": { "description": "Validation error" },
        "401": { "description": "Unauthorized" }
        }
    }
    },
    "/carts/update": {
    "put": {
        "tags": ["Cart"],
        "summary": "Update product quantity in cart",
        "description": "Updates the quantity of a product in the authenticated user's cart.",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
        "required": true,
        "content": {
            "application/json": {
            "schema": {
                "type": "object",
                "required": ["productId", "quantity"],
                "properties": {
                "productId": {
                    "type": "string",
                    "example": "67fc1f0afd41c314c3dde5f1"
                },
                "quantity": { "type": "integer", "example": 2 }
                }
            }
            }
        }
        },
        "responses": {
        "200": { "description": "Cart updated" },
        "400": { "description": "Validation error" },
        "401": { "description": "Unauthorized" }
        }
    }
    },
    "/carts/remove": {
    "delete": {
        "tags": ["Cart"],
        "summary": "Remove product from cart",
        "description": "Removes a specific product from the authenticated user's cart.",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
        "required": true,
        "content": {
            "application/json": {
            "schema": {
                "type": "object",
                "required": ["productId"],
                "properties": {
                "productId": {
                    "type": "string",
                    "example": "67fc1f0afd41c314c3dde5f1"
                }
                }
            }
            }
        }
        },
        "responses": {
        "200": { "description": "Product removed from cart" },
        "400": { "description": "Validation error" },
        "401": { "description": "Unauthorized" }
        }
    }
    },
    "/carts/clear": {
    "delete": {
        "tags": ["Cart"],
        "summary": "Clear cart",
        "description": "Removes all products from the authenticated user's cart.",
        "security": [{ "cookieAuth": [] }],
        "responses": {
        "200": { "description": "Cart cleared" },
        "401": { "description": "Unauthorized" }
        }
    }
    },
    "/orders/user/{userId}": {
    "get": {
        "tags": ["Orders"],
        "summary": "Get all orders by user",
        "description": "Returns all orders placed by a specific user.",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
        {
            "name": "userId",
            "in": "path",
            "required": true,
            "description": "MongoDB user ID",
            "schema": { "type": "string" }
        }
        ],
        "responses": {
        "200": { "description": "List of orders" },
        "401": { "description": "Unauthorized" },
        "404": { "description": "No orders found" }
        }
    }
    },
    "/orders/number/{orderNumber}": {
    "get": {
        "tags": ["Orders"],
        "summary": "Get order by number",
        "description": "Returns a single order by its order number (e.g. ORD-1774386355677).",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
        {
            "name": "orderNumber",
            "in": "path",
            "required": true,
            "description": "Order number",
            "schema": { "type": "string" }
        }
        ],
        "responses": {
        "200": { "description": "Order data" },
        "401": { "description": "Unauthorized" },
        "404": { "description": "Order not found" }
        }
    }
    },
    "/orders/{orderId}": {
    "get": {
        "tags": ["Orders"],
        "summary": "Get order by ID",
        "description": "Returns a single order by its MongoDB ID.",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
        {
            "name": "orderId",
            "in": "path",
            "required": true,
            "description": "MongoDB order ID",
            "schema": { "type": "string" }
        }
        ],
        "responses": {
        "200": { "description": "Order data" },
        "401": { "description": "Unauthorized" },
        "404": { "description": "Order not found" }
        }
    }
    },
    "/orders/{orderId}/status": {
    "patch": {
        "tags": ["Orders"],
        "summary": "Update order status",
        "description": "Updates the status of an order. Valid statuses: pending, paid, shipped, delivered, cancelled.",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
        {
            "name": "orderId",
            "in": "path",
            "required": true,
            "description": "MongoDB order ID",
            "schema": { "type": "string" }
        }
        ],
        "requestBody": {
        "required": true,
        "content": {
            "application/json": {
            "schema": {
                "type": "object",
                "properties": {
                "status": {
                    "type": "string",
                    "enum": [
                    "pending",
                    "paid",
                    "shipped",
                    "delivered",
                    "cancelled"
                    ]
                }
                }
            }
            }
        }
        },
        "responses": {
        "200": { "description": "Order status updated" },
        "401": { "description": "Unauthorized" }
        }
    }
    },
    "/orders/{orderId}/payment-status": {
    "patch": {
        "tags": ["Orders"],
        "summary": "Update payment status",
        "description": "Manually updates the payment status of an order. Valid statuses: pending, paid, failed.",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
        {
            "name": "orderId",
            "in": "path",
            "required": true,
            "description": "MongoDB order ID",
            "schema": { "type": "string" }
        }
        ],
        "requestBody": {
        "required": true,
        "content": {
            "application/json": {
            "schema": {
                "type": "object",
                "properties": {
                "paymentStatus": {
                    "type": "string",
                    "enum": ["pending", "paid", "failed"]
                }
                }
            }
            }
        }
        },
        "responses": {
        "200": { "description": "Payment status updated" },
        "401": { "description": "Unauthorized" }
        }
    }
    },
    "/orders/{orderId}/delivered": {
    "patch": {
        "tags": ["Orders"],
        "summary": "Mark order as delivered",
        "description": "Marks an order as delivered and sets the deliveredAt timestamp.",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
        {
            "name": "orderId",
            "in": "path",
            "required": true,
            "description": "MongoDB order ID",
            "schema": { "type": "string" }
        }
        ],
        "responses": {
        "200": { "description": "Order marked as delivered" },
        "401": { "description": "Unauthorized" }
        }
    }
    },
    "/orders/{orderId}/cancel": {
    "delete": {
        "tags": ["Orders"],
        "summary": "Cancel order",
        "description": "Cancels an order and updates its status to cancelled.",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
        {
            "name": "orderId",
            "in": "path",
            "required": true,
            "description": "MongoDB order ID",
            "schema": { "type": "string" }
        }
        ],
        "responses": {
        "200": { "description": "Order cancelled" },
        "401": { "description": "Unauthorized" }
        }
    }
    },
    "/payments/create-intent": {
    "post": {
        "tags": ["Payments"],
        "summary": "Create payment intent",
        "description": "Creates a Stripe PaymentIntent and saves a pending order in the database. Returns the client_secret needed to confirm the payment on the frontend.",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
        "required": true,
        "content": {
            "application/json": {
            "schema": {
                "type": "object",
                "required": ["userId", "items", "shippingAddress"],
                "properties": {
                "userId": { "type": "string" },
                "items": {
                    "type": "array",
                    "items": {
                    "type": "object",
                    "properties": {
                        "productId": { "type": "string" },
                        "name": { "type": "string" },
                        "quantity": { "type": "integer" },
                        "price": { "type": "number" },
                        "subtotal": { "type": "number" }
                    }
                    }
                },
                "shippingAddress": {
                    "type": "object",
                    "properties": {
                    "fullName": { "type": "string" },
                    "address": { "type": "string" },
                    "city": { "type": "string" },
                    "state": { "type": "string" },
                    "zipCode": { "type": "string" },
                    "country": { "type": "string" },
                    "phone": { "type": "string" },
                    "notes": { "type": "string" }
                    }
                }
                }
            }
            }
        }
        },
        "responses": {
        "200": {
            "description": "Payment intent created with client_secret and orderId"
        },
        "400": { "description": "Validation error" },
        "401": { "description": "Unauthorized" }
        }
    }
    },
    "/payments/confirm": {
    "post": {
        "tags": ["Payments"],
        "summary": "Confirm payment",
        "description": "Confirms a payment by checking its status with Stripe and updates the order accordingly.",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
        "required": true,
        "content": {
            "application/json": {
            "schema": {
                "type": "object",
                "required": ["paymentIntentId"],
                "properties": {
                "paymentIntentId": { "type": "string" }
                }
            }
            }
        }
        },
        "responses": {
        "200": { "description": "Payment confirmed" },
        "400": { "description": "Validation error" },
        "401": { "description": "Unauthorized" }
        }
    }
    },
    "/payments/cancel": {
    "post": {
        "tags": ["Payments"],
        "summary": "Cancel payment",
        "description": "Cancels a Stripe PaymentIntent and updates the order status to cancelled.",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
        "required": true,
        "content": {
            "application/json": {
            "schema": {
                "type": "object",
                "required": ["paymentIntentId"],
                "properties": {
                "paymentIntentId": { "type": "string" }
                }
            }
            }
        }
        },
        "responses": {
        "200": { "description": "Payment cancelled" },
        "400": { "description": "Validation error" },
        "401": { "description": "Unauthorized" }
        }
    }
    },
    "/payments/webhook": {
    "post": {
        "tags": ["Payments"],
        "summary": "Stripe webhook",
        "description": "Endpoint for Stripe webhook events. Handles payment_intent.succeeded and payment_intent.payment_failed events to update order status automatically.",
        "responses": {
        "200": { "description": "Webhook received" }
        }
    }
    }
}
}
